# ============================================================
# BluaDiagnostics Sprint 2 — Template de variáveis de ambiente
# ============================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores reais no .env
#   3. NUNCA commite o .env (já está no .gitignore)
#
# IMPORTANTE: os placeholders abaixo são OBVIAMENTE falsos.
# Se você os substituir e commitar por engano, ainda é seguro.
# ============================================================

# ---- LLM Provider Principal: Groq ----
# Obter chave em: https://console.groq.com/keys
GROQ_API_KEY=COLE_SUA_CHAVE_GROQ_AQUI_NAO_COMMITE
GROQ_MODEL_PRINCIPAL=llama-3.1-8b-instant
GROQ_MODEL_PREMIUM=llama-3.3-70b-versatile

# ---- LLM Provider Alternativo: Ollama (local — bônus LGPD) ----
# Instalar: curl -fsSL https://ollama.com/install.sh | sh
# Baixar modelo: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ---- Provider ativo: "groq" ou "ollama" ----
LLM_PROVIDER=groq

# ---- Embeddings (RAG) ----
# Padrão: sentence-transformers multilíngue, roda local sem custo
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- Vector Store (ChromaDB) ----
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=blua_kb

# ---- Observabilidade: LangSmith (opcional — bônus) ----
# Obter chave em: https://smith.langchain.com/settings
LANGSMITH_API_KEY=COLE_SUA_CHAVE_LANGSMITH_AQUI_NAO_COMMITE
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=bluadiagnostics-sprint2

# ---- Configuração do agente ----
TEMPERATURE=0.2
TOP_P=0.9
MAX_TOKENS=1024

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=./logs/blua.log
