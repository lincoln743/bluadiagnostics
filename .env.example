# =====================================================
# BluaDiagnostics — Variaveis de ambiente (TEMPLATE)
# =====================================================
# 1. Copie este arquivo para `.env`
# 2. Preencha com suas chaves reais
# 3. NUNCA commite o arquivo .env (ja esta no .gitignore)
# =====================================================

# --- Groq API (obrigatorio) ---
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Configuracoes gerais ---
MODEL_ID=llama-3.3-70b-versatile
MAX_TOKENS=1024
TEMPERATURE=0.2

# --- Care Plus mock (simulacao) ---
CAREPLUS_API_BASE=https://mock.care-plus.local/v1
CAREPLUS_TOKEN=mock-token-development
